{
	"name": "viko",
	"private": true,
	"version": "0.0.1",
	"description": "Desktop-first video editor built with SvelteKit. Frame-precise multi-track timeline with keyframes, color grading, chroma key, captions and effects, with fully offline MP4 export.",
	"keywords": [
		"video editor",
		"browser based video editor",
		"online video editor",
		"free video editor",
		"video editing software",
		"timeline editor",
		"keyframe animation",
		"color grading",
		"mp4 export",
		"svelte",
		"sveltekit"
	],
	"author": "Pimatis",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 8080 --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"@huggingface/transformers": "^4.2.0",
		"mp4-muxer": "^5.2.2",
		"uisfx": "^0.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource/bebas-neue": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.34.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2"
	},
	"overrides": {
		"postcss": "8.5.26",
		"nanoid": "3.3.18",
		"brace-expansion": "5.0.9",
		"cookie": "0.7.2"
	}
}
